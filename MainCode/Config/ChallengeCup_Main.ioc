# CAN1/CAN2: 1 Mbit/s at APB1=42 MHz (3 * (1 + 9 + 4) TQ)
CAN1.Mode=CAN_MODE_NORMAL
CAN1.Prescaler=3
CAN1.BS1=CAN_BS1_9TQ
CAN1.BS2=CAN_BS2_4TQ
CAN1.SJW=CAN_SJW_1TQ
CAN1.NART=DISABLE
CAN1.CalculateTimeQuantum=71.42857142857143
CAN1.IPParameters=Mode,Prescaler,BS1,BS2,SJW,NART,CalculateTimeQuantum
CAN2.Mode=CAN_MODE_NORMAL
CAN2.Prescaler=3
CAN2.BS1=CAN_BS1_9TQ
CAN2.BS2=CAN_BS2_4TQ
CAN2.SJW=CAN_SJW_1TQ
CAN2.NART=DISABLE
CAN2.CalculateTimeQuantum=71.42857142857143
CAN2.IPParameters=Mode,Prescaler,BS1,BS2,SJW,NART,CalculateTimeQuantum

# LAN8720A on the board's RMII pins; PHY uses its own 25 MHz crystal.
ETH.MediaInterface=ETH_MEDIA_INTERFACE_RMII
ETH.AutoNegotiation=ETH_AUTONEGOTIATION_ENABLE
ETH.Speed=ETH_SPEED_100M
ETH.PhyAddress=0
ETH.PHY_Name_RMII=userPHY
ETH.PHY_User_Name=LAN8720A
ETH.PHY_SR=31
ETH.IPParameters=MediaInterface,AutoNegotiation,Speed,PhyAddress,PHY_SR,PHY_Name_RMII,PHY_User_Name

# lwIP is polled from the main loop (NO_SYS=1), with a static IPv4 address.
LWIP.LWIP_DHCP=0
LWIP.LWIP_TCP=0
LWIP.IP_ADDRESS=192.168.001.010
LWIP.NETMASK_ADDRESS=255.255.255.000
LWIP.GATEWAY_ADDRESS=192.168.001.001
LWIP.IPParameters=LWIP_DHCP,LWIP_TCP,IP_ADDRESS,NETMASK_ADDRESS,GATEWAY_ADDRESS
LWIP.Version=v2.0.3_Cube

# USART3 460800 8N1, TX-only VOFA+ FireWater diagnostics on PB10.
USART3.Mode=Asynchronous
USART3.BaudRate=460800
USART3.WordLength=UART_WORDLENGTH_8B
USART3.StopBits=UART_STOPBITS_1
USART3.Parity=UART_PARITY_NONE
USART3.HwFlowCtl=UART_HWCONTROL_NONE
USART3.OverSampling=UART_OVERSAMPLING_16
USART3.IPParameters=Mode,BaudRate,WordLength,StopBits,Parity,HwFlowCtl,OverSampling

# USART6 460800 8N1, with circular DMA2 Stream1/Channel5 for RX.
USART6.Mode=Asynchronous
USART6.BaudRate=460800
USART6.WordLength=UART_WORDLENGTH_8B
USART6.StopBits=UART_STOPBITS_1
USART6.Parity=UART_PARITY_NONE
USART6.HwFlowCtl=UART_HWCONTROL_NONE
USART6.OverSampling=UART_OVERSAMPLING_16
USART6.IPParameters=Mode,BaudRate,WordLength,StopBits,Parity,HwFlowCtl,OverSampling
Dma.Request0=USART6_RX
Dma.RequestsNb=1
Dma.USART6_RX.0.Instance=DMA2_Stream1
Dma.USART6_RX.0.Direction=DMA_PERIPH_TO_MEMORY
Dma.USART6_RX.0.PeriphInc=DMA_PINC_DISABLE
Dma.USART6_RX.0.MemInc=DMA_MINC_ENABLE
Dma.USART6_RX.0.PeriphDataAlignment=DMA_PDATAALIGN_BYTE
Dma.USART6_RX.0.MemDataAlignment=DMA_MDATAALIGN_BYTE
Dma.USART6_RX.0.Mode=DMA_CIRCULAR
Dma.USART6_RX.0.Priority=DMA_PRIORITY_HIGH
Dma.USART6_RX.0.FIFOMode=DMA_FIFOMODE_DISABLE
Dma.USART6_RX.0.RequestParameters=Instance,Direction,PeriphInc,MemInc,PeriphDataAlignment,MemDataAlignment,Mode,Priority,FIFOMode

