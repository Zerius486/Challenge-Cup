# CMake/Ninja build trees and generated firmware outputs
/MainCode/build/
/MainCode/output/firmware/*
!/MainCode/output/firmware/.gitkeep
/MainCode/output/standalone_tests/*
!/MainCode/output/standalone_tests/.gitkeep

# Temporary files and host-test caches
/tmp/
**/__pycache__/
*.py[cod]
*.pdb

# Keil/MDK generated output in the retained board examples
Reference/Board/Examples/**/Project/OBJ/
Reference/Board/Examples/**/Project/LIST/
Reference/Board/Examples/**/*.o
Reference/Board/Examples/**/*.d
Reference/Board/Examples/**/*.crf
Reference/Board/Examples/**/*.axf
Reference/Board/Examples/**/*.hex
Reference/Board/Examples/**/*.bin
Reference/Board/Examples/**/*.elf
Reference/Board/Examples/**/*.map
Reference/Board/Examples/**/*.lst
Reference/Board/Examples/**/*.dep
Reference/Board/Examples/**/*.htm
Reference/Board/Examples/**/*.lnp
Reference/Board/Examples/**/*.sct
Reference/Board/Examples/**/*.uvoptx
Reference/Board/Examples/**/*.uvguix*

# IDE and operating-system metadata
.vs/
.vscode/
*.user
*.suo
*.DS_Store
Thumbs.db
